<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required under the hardened runtime: AdviceActionRunner.emptyTrash sends an
         Apple event to Finder IN-PROCESS via NSAppleScript. Without this entitlement
         the send fails with errAEEventNotPermitted (-1743) even when TCC has approved
         the app. (The login-items read goes through a child /usr/bin/osascript, which
         carries its own signature, but this entitlement covers both honestly.) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
